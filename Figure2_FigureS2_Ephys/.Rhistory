gene_name %in% c(
up_label_genes,
down_label_genes
),
"Yes",
"No"
),
label_direction = dplyr::case_when(
gene_name %in% up_label_genes ~ "Increased",
gene_name %in% down_label_genes ~ "Decreased",
TRUE ~ "Not_labeled"
)
)
}
)
write.csv(
CLIPscore_labeled_volcano_data,
file.path(
Outdirectory,
"Source_Data_Figures_5i_5j.csv"
),
row.names = FALSE
)
