RiboTag_Metadata_IP <- RiboTag_Metadata[colnames(RiboTag_count_matrix_IP), , drop = FALSE]
# Clean condition labels for plotting
make_condition_label <- function(x) {
dplyr::case_when(
x %in% c("Control_Control", "Control_30min") ~ "Control",
x %in% c("ChR2_5min") ~ "5 min",
x %in% c("ChR2_30min") ~ "30 min",
TRUE ~ as.character(x)
)
}
condition_label_levels <- c("Control", "5 min", "30 min")
get_pairwise_correlations <- function(mat, meta, assay_name, condition_col = "Condition") {
meta <- meta[colnames(mat), , drop = FALSE]
cor_mat <- cor(mat, method = "pearson", use = "pairwise.complete.obs")
pair_df <- as.data.frame(as.table(cor_mat)) %>%
dplyr::rename(
Sample1 = Var1,
Sample2 = Var2,
Correlation = Freq
) %>%
dplyr::filter(as.character(Sample1) < as.character(Sample2)) %>%
dplyr::mutate(
Assay = assay_name,
Condition1 = as.character(meta[as.character(Sample1), condition_col]),
Condition2 = as.character(meta[as.character(Sample2), condition_col]),
Pair_type = ifelse(Condition1 == Condition2, "Within condition", "Across condition"),
Condition_label = make_condition_label(Condition1),
Condition_label = factor(Condition_label, levels = condition_label_levels)
)
return(pair_df)
}
CLIP_pairwise_cor <- get_pairwise_correlations(
mat = CLIP_count_matrix,
meta = CLIP_Metadata,
assay_name = "FMRP CLIP",
condition_col = "Condition"
)
RiboTag_pairwise_cor <- get_pairwise_correlations(
mat = RiboTag_count_matrix_IP,
meta = RiboTag_Metadata_IP,
assay_name = "RiboTag",
condition_col = "Group"
)
pairwise_cor_df <- bind_rows(
CLIP_pairwise_cor,
RiboTag_pairwise_cor
)
write.csv(
pairwise_cor_df,
file.path(Outdirectory, "CLIP_vs_RiboTag_pairwise_sample_correlations.csv"),
row.names = FALSE
)
within_condition_cor_summary <- pairwise_cor_df %>%
dplyr::filter(Pair_type == "Within condition") %>%
dplyr::group_by(Assay, Condition_label) %>%
dplyr::summarise(
Mean_correlation = mean(Correlation, na.rm = TRUE),
Median_correlation = median(Correlation, na.rm = TRUE),
SD_correlation = sd(Correlation, na.rm = TRUE),
Min_correlation = min(Correlation, na.rm = TRUE),
Max_correlation = max(Correlation, na.rm = TRUE),
N_pairs = dplyr::n(),
.groups = "drop"
)
write.csv(
within_condition_cor_summary,
file.path(Outdirectory, "CLIP_vs_RiboTag_within_condition_correlation_summary.csv"),
row.names = FALSE
)
p_sample_cor <- pairwise_cor_df %>%
dplyr::filter(Pair_type == "Within condition") %>%
ggplot(aes(x = Condition_label, y = Correlation)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.15, size = 2, alpha = 0.7) +
facet_wrap(~ Assay, scales = "free_x") +
theme_illustrator_black +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
strip.background = element_rect(fill = "white", color = "black"),
strip.text = element_text(color = "black")
) +
labs(
title = "Sample-level replicate correlations",
x = NULL,
y = "Pairwise Pearson correlation"
)
print(p_sample_cor)
