dplyr::filter(region %in% region_levels, !is.na(gene_name)) %>%
dplyr::mutate(
region    = factor(region, levels = region_levels),
Condition = factor(Condition, levels = condition_levels),
Sample    = factor(Sample, levels = levels(STAR_Tx_Crepos$Sample))
)
