RiboTag_vst_mat <- as.matrix(RiboTag_count_matrix_IP)
get_gene_variability <- function(mat, meta, assay_name, condition_col = "Condition") {
meta <- meta[colnames(mat), , drop = FALSE]
purrr::map_dfr(unique(meta[[condition_col]]), function(cond) {
samples <- rownames(meta)[meta[[condition_col]] == cond]
if (length(samples) < 2) {
return(NULL)
}
submat <- mat[, samples, drop = FALSE]
tibble(
Gene = rownames(submat),
Assay = assay_name,
Condition = as.character(cond),
Condition_label = make_condition_label(cond),
Mean = rowMeans(submat, na.rm = TRUE),
SD = apply(submat, 1, sd, na.rm = TRUE),
Variance = apply(submat, 1, var, na.rm = TRUE)
)
})
}
CLIP_gene_var <- get_gene_variability(
mat = CLIP_log_mat,
meta = CLIP_Metadata,
assay_name = "FMRP CLIP",
condition_col = "Condition"
)
RiboTag_gene_var <- get_gene_variability(
mat = RiboTag_vst_mat,
meta = RiboTag_Metadata_IP,
assay_name = "RiboTag",
condition_col = "Group"
)
gene_var_df <- bind_rows(
CLIP_gene_var,
RiboTag_gene_var
) %>%
dplyr::filter(
is.finite(SD),
Mean > 0
) %>%
dplyr::mutate(
Condition_label = factor(Condition_label, levels = condition_label_levels)
)
gene_var_summary <- gene_var_df %>%
dplyr::group_by(Assay, Condition_label) %>%
dplyr::summarise(
Median_SD = median(SD, na.rm = TRUE),
Mean_SD = mean(SD, na.rm = TRUE),
Median_variance = median(Variance, na.rm = TRUE),
Mean_variance = mean(Variance, na.rm = TRUE),
N_genes = dplyr::n(),
.groups = "drop"
)
write.csv(
gene_var_summary,
file.path(Outdirectory, "CLIP_vs_RiboTag_gene_level_variability_summary.csv"),
row.names = FALSE
)
print(gene_var_summary)
